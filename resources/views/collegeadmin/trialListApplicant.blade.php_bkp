  function hundred_mt_score(application_no , gender){


    hundtime = $(`#hundtime${application_no}`).val()

if(hundtime == 0){
var hund_mt = $(`#hund${application_no}`).val('')
}else if(hundtime <= 12.49 && gender == 1){
var hund_mt = $(`#hund${application_no}`).val(10)
}else if(hundtime >= 12.50 && hundtime <= 13.49 && gender == 1){
    var hund_mt = $(`#hund${application_no}`).val(8);
}else if(hundtime >= 13.50 && hundtime <= 14.49 && gender == 1){
    var hund_mt = $(`#hund${application_no}`).val(6);
}else if(hundtime >= 14.50 && hundtime <= 15.49 && gender == 1){
    var hund_mt = $(`#hund${application_no}`).val(4.5);
}else if(hundtime >= 15.50 && hundtime <= 16.49 && gender == 1){
    var hund_mt = $(`#hund${application_no}`).val(3);
}else if(hundtime >= 16.50 && hundtime <= 17.49 && gender == 1){
    var hund_mt = $(`#hund${application_no}`).val(1.5);
}else if(hundtime >= 17.50 && gender == 1){
    var hund_mt = $(`#hund${application_no}`).val(0);
}else if(hundtime <= 14.49 && gender == 2){
    var hund_mt = $(`#hund${application_no}`).val(10);
}else if(hundtime >= 14.50 && hundtime <= 15.49 && gender == 2){
    var hund_mt = $(`#hund${application_no}`).val(8);
}else if(hundtime >= 15.50 && hundtime <= 16.49 && gender == 2){
    var hund_mt = $(`#hund${application_no}`).val(6);
}else if(hundtime >= 16.50 && hundtime <= 17.49 && gender == 2 ){
    var hund_mt = $(`#hund${application_no}`).val(4.5);
}else if(hundtime >= 17.50 && hundtime <= 18.49 && gender == 2 ){
    var hund_mt = $(`#hund${application_no}`).val(3);
}else if(hundtime >= 18.50 && hundtime <= 19.49 && gender == 2 ){
    var hund_mt = $(`#hund${application_no}`).val(1.5);
}else if(hundtime >= 19.50 && gender == 2 ){
    var hund_mt = $(`#hund${application_no}`).val(0);
}

allAdd(application_no)
  }




function eight_mt_score(application_no , gender){

   eighttime_new = parseFloat(+$(`#eighttime${application_no}`).val());

    if(eighttime_new.toFixed(2).split(".")[1] >= 60){
        eighttime= $(`#eighttime${application_no}`).val(+eighttime_new.toFixed(2).split(".")[0] + 1)
    }else{
        eighttime= $(`#eighttime${application_no}`).val()
