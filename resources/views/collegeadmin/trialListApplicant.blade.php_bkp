<script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
<script>
  function sporttype(sport) {
    var subsports_id = $("#sport").attr('data-subsport');
    var gender = $("#sport").attr('data-gender');
    $.ajax({
      type: "POST",
      url: "{{url('collegeadmin/get_subsport')}}",
      data: {
        sport
      },
      success: function(response) {
        var d = $('select[name="subsport"]').empty();
        $('select[name="subsport"]').append(
          '<option value="">Select Sub Sport</option>');
        $.each(response.sub_type, function(key, value) {
          $('select[name="subsport"]').append(
            `<option  ${value.id==subsports_id?'selected':''} value="${value.id}"> ${value.sub_type} </option>`);
        });
        if (response.gender == 3) {
          var c = $('select[name="gender"]').empty();
          $('select[name="gender"]').append(
            '<option value="">Select Gender</option>');
          $('select[name="gender"]').append(
            `<option value="3" ${gender == 3 ?'selected':''} >Both</option>'1`);
        } else if (response.gender == 1) {
          var c = $('select[name="gender"]').empty();
          $('select[name="gender"]').append(
            '<option value="">Select Gender</option>');
          $('select[name="gender"]').append(
            `<option value="1" ${gender == 1 ?'selected':''}>Male</option>`);
        } else if (response.gender == 2) {
          var c = $('select[name="gender"]').empty();
          $('select[name="gender"]').append(
            '<option value="">Select Gender</option>');
          $('select[name="gender"]').append(
            `<option value="2" ${gender == 2 ?'selected':''} >Female</option>`);
        } else if (response.gender == 4) {
          var c = $('select[name="gender"]').empty();
          $('select[name="gender"]').append(
            '<option value="">Select Gender</option>');
          $('select[name="gender"]').append(
            `<option value="1" ${gender == 1 ?'selected':''} >Male</option>`);
          $('select[name="gender"]').append(
            `<option value="2" ${gender == 2 ?'selected':''} >Female</option>`);
        } else {
          var c = $('select[name="gender"]').empty();
          $('select[name="gender"]').append(
            '<option value="">Select Gender</option>');
        };
        // }
        // if (response.gender == 3) {
        // 	$( 'select[name="gender"]' ).append(
        // 	'<option value="">Select Gender</option>
        // 	<option value="3">Male & Female</option>' );
        // } else if (response.gender == 1) {
        // 	$( 'select[name="gender"]' ).append(
        // 	'<option value="">Select Gender</option>
        // 	<option value="1">Male</option>' );
        //     }
        // 	else if (response.gender == 2) {
        // 	$( 'select[name="gender"]' ).append(
        // 	'<option value="">Select Gender</option>
        // 	<option value="2">Female</option>' );
        //     }
        // 	else if (response.gender == 4) {
        // 	$( 'select[name="gender"]' ).append(
        // 	'<option value="">Select Gender</option>
        // 	<option value="1">Male</option>
        // 	<option value="2">Female</option>' );
        //     };
      }
    })
  }


  function mainTotal(application_no) {
    var game_technique = $(`#game_technique${application_no}`).val();
    var test_score_mark = $(`#test_score_mark${application_no}`).val();
    var total = parseFloat(game_technique) + parseFloat(test_score_mark);
    var sport_test_mark = $(`#sport_test_mark${application_no}`).val(total);
    var phy = $(`#phy${application_no}`).val();
    var mainTotal = total + parseFloat(phy);
    $(`#total_obtain_mark${application_no}`).val(mainTotal);

  }

  function badskillTotal(application_no) {
    var high_double_service_mark = $(`#high_double_service_mark${application_no}`).val();
    var smash_mark = $(`#smash_mark${application_no}`).val();
    var drop_mark = $(`#drop_mark${application_no}`).val();
    var backhand_mark = $(`#backhand_mark${application_no}`).val();
    var total = parseFloat(high_double_service_mark) + parseFloat(smash_mark) + parseFloat(drop_mark) + parseFloat(backhand_mark);
    $(`#test_score_mark${application_no}`).val(total);
  }

  function footballkeeperskillTotal(application_no) {
    var grip_mark = $(`#grip_mark${application_no}`).val();
    var dive_mark = $(`#dive_mark${application_no}`).val();
    var patch_mark = $(`#patch_mark${application_no}`).val();
    var kick_mark = $(`#kick_mark${application_no}`).val();
    var total = parseFloat(grip_mark) + parseFloat(dive_mark) + parseFloat(patch_mark) + parseFloat(kick_mark);
    $(`#test_score_mark${application_no}`).val(total);
  }



  function kustiskillTotal(application_no) {
    var ground_position_mark = $(`#ground_position_mark${application_no}`).val();
    var front_position_back_position_mark = $(`#front_position_back_position_mark${application_no}`).val();

    var total = parseFloat(ground_position_mark) + parseFloat(front_position_back_position_mark);
    $(`#test_score_mark${application_no}`).val(total);
  }

  function judoskillTotal(application_no) {
    var straight_work_throw_mark = $(`#straight_work_throw_mark${application_no}`).val();
    var hip_leg_hand_techniquec_mark = $(`#hip_leg_hand_techniquec_mark${application_no}`).val();
    var throw_count_mark = $(`#throw_count_mark${application_no}`).val();
    var throw_combination_mark = $(`#throw_combination_mark${application_no}`).val();
    var total = parseFloat(straight_work_throw_mark) + parseFloat(hip_leg_hand_techniquec_mark) + parseFloat(throw_count_mark) + parseFloat(throw_combination_mark);
    $(`#test_score_mark${application_no}`).val(total);
  }

  function footballskillTotal(application_no) {
    var dribble_tackle_mark = $(`#dribble_tackle_mark${application_no}`).val();
    var head_mark = $(`#head_mark${application_no}`).val();
    var control_pad_mark = $(`#control_pad_mark${application_no}`).val();
    var kick_mark = $(`#kick_mark${application_no}`).val();
    var total = parseFloat(dribble_tackle_mark) + parseFloat(head_mark) + parseFloat(control_pad_mark) + parseFloat(kick_mark);
    $(`#test_score_mark${application_no}`).val(total);
  }

  function volleyballskillTotal(application_no) {
    var under_hand_mark = $(`#under_hand_mark${application_no}`).val();
    var upper_hand_mark = $(`#upper_hand_mark${application_no}`).val();
    var service_mark = $(`#service_mark${application_no}`).val();
    var smash_mark = $(`#smash_mark${application_no}`).val();
    var total = parseFloat(under_hand_mark) + parseFloat(upper_hand_mark) + parseFloat(service_mark) + parseFloat(smash_mark);
    $(`#test_score_mark${application_no}`).val(total);
  }

  function hockeyskillTotal(application_no) {
    var hit_mark = $(`#hit_mark${application_no}`).val();
    var push_mark = $(`#push_mark${application_no}`).val();
    var scoop_mark = $(`#scoop_mark${application_no}`).val();
    var dribbling_mark = $(`#dribbling_mark${application_no}`).val();
    var total = parseFloat(hit_mark) + parseFloat(push_mark) + parseFloat(scoop_mark) + parseFloat(dribbling_mark);
